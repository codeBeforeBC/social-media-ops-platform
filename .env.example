# 普通使用者通常只需保留默认值；不在此保存真实凭据。
YOYO_PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# 原生开发使用 compose.dev.yaml 暴露的独立开发数据库。
# DATABASE_URL=postgresql://yoyo:<生成的数据库密码>@127.0.0.1:54329/yoyo
# STATE_DIR=.local/state
SESSION_ABSOLUTE_SECONDS=43200
SESSION_IDLE_SECONDS=7200
# AI/OCR/来源凭据和预算不默认开启，后续阶段按需配置。

# S2 private objects; browser-reachable endpoint. Keep database/objects in separate test instances.
S3_ENDPOINT=http://127.0.0.1:59000
S3_PUBLIC_ENDPOINT=http://localhost:59000
S3_BUCKET=yoyo-private
S3_PORT=59000
