# 普通使用者通常只需保留默认值；不在此保存真实凭据。
YOYO_PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# 原生开发使用 compose.dev.yaml 暴露的独立开发数据库。
# DATABASE_URL=postgresql://yoyo:<生成的数据库密码>@127.0.0.1:54329/yoyo
# STATE_DIR=.local/state
SESSION_ABSOLUTE_SECONDS=43200
SESSION_IDLE_SECONDS=7200
# AI/OCR/来源凭据和预算不默认开启，后续阶段按需配置。

# S2 private objects; browser-reachable endpoint. Keep database/objects in separate test instances.
S3_ENDPOINT=http://127.0.0.1:59000
S3_PUBLIC_ENDPOINT=http://localhost:59000
S3_BUCKET=yoyo-private
S3_PORT=59000

# S3: native OpenCLI adapter uses a host browser; configure each cloned instance separately.
# Run pnpm sources:setup, then pnpm sources:bridge on the host.
# For Docker: SOURCE_BRIDGE_URL=http://host.docker.internal:59025
# SOURCE_BRIDGE_TOKEN=<from the host's ignored .local/state/source-bridge-token>
# Native workers may use .local/providers/opencli directly.

# Optional native AI credential file (0600); configure with pnpm ai:config set via stdin.
# Compose uses /state/ai.json in the persistent state volume. Never put keys in this file.
# AI_CONFIG_FILE=.local/ai/deepseek.json
