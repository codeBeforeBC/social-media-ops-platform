{
  "name": "yoyo-workbench",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.json && pnpm --filter @yoyo/web build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @yoyo/web typecheck",
    "dev": "node tools/dev.mjs",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "pnpm --filter @yoyo/web dev",
    "worker": "tsx apps/worker/src/main.ts",
    "scheduler": "tsx apps/scheduler/src/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "setup-token": "tsx tools/setup-token.ts",
    "test": "node tools/test-env.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "check:s2": "node tools/s2/check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
