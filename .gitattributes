# Preserve PDF bytes and classify them as binary (xref records contain required spaces).
*.pdf binary
# Preserve captured execution logs, including terminal trailing spaces and final blank lines.
docs/evidence/s2/*.log whitespace=-blank-at-eol,-blank-at-eof

# Spreadsheet CSV retains RFC4180 CRLF rows.
docs/templates/yoyo-import-v1.csv whitespace=cr-at-eol
