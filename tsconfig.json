{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node", "outDir": "dist", "rootDir": ".",
    "strict": true, "esModuleInterop": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "skipLibCheck": true, "resolveJsonModule": true, "noUncheckedIndexedAccess": true
  },
  "include": ["apps/api/src/**/*.ts", "apps/worker/src/**/*.ts", "apps/scheduler/src/**/*.ts", "packages/**/src/**/*.ts", "tools/*.ts", "tests/*.ts"]
}
